# Database
DATABASE_URL="postgresql://user:password@localhost:5432/simple_yoyaku_kanri"

# Server
PORT=3001
NODE_ENV=development

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Admin Settings
ALLOW_MULTIPLE_ADMINS=false

# Initial Admin Seeding (Optional)
# Set these to automatically create the initial admin user on first startup
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=your-secure-password
# AUTO_SEED_ADMIN=false

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000